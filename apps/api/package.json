{
  "name": "@curavet/api",
  "version": "1.0.0",
  "description": "GlamBot multi-tenant WhatsApp booking API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node --import tsx scripts/smoke.ts",
    "routes": "node --import tsx scripts/dump-routes.ts",
    "seed": "tsx src/seed.ts",
    "agent:try": "tsx src/ai/test-agent.ts",
    "scheduler:demo": "tsx src/services/test-scheduler.ts",
    "db:generate": "pnpm --filter @curavet/db exec prisma generate",
    "db:validate": "pnpm --filter @curavet/db exec prisma validate",
    "db:migrate": "pnpm --filter @curavet/db exec prisma migrate dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/csrf-protection": "^8.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^11.0.0",
    "bullmq": "^5.12.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "franc": "^6.2.0",
    "ioredis": "^5.4.1",
    "node-cron": "^4.6.0",
    "openai": "^7.23.0",
    "prom-client": "^15.1.3",
    "stripe": "^22.6.2",
    "ws": "^8.21.3",
    "@curavet/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "5.0.2"
  }
}
