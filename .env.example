# GlamBot production environment template
# Copy to .env and provide real secrets. Never commit populated values.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_API_URL="https://api.glambot.io"

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxx.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxx.supabase.co:5432/postgres"

# ── Queue (BullMQ / Redis) ───────────────────────────────────────────────────
# QUEUE_ENABLED=false runs without Redis; reminders, broadcasts and lifecycle
# sweeps are simply skipped. Never disable this in production.
REDIS_URL="redis://localhost:6379"
QUEUE_ENABLED=true

# ── Security ─────────────────────────────────────────────────────────────────
# Both secrets must be set in production. The API hard-fails to boot when it
# detects the built-in development defaults.
#   openssl rand -base64 48
JWT_SECRET="replace-with-64-char-random-secret"
CREDENTIALS_ENCRYPTION_KEY="replace-with-32-char-random-secret"
JWT_TTL_SECONDS="604800"

SUPERADMIN_EMAIL="admin@glambot.io"
SUPERADMIN_PASSWORD="replace-with-strong-password"

# ── AI providers ─────────────────────────────────────────────────────────────
# At least one is required for the assistant to answer. Tenants can pin a
# specific model (see MODEL_CATALOG in apps/api/src/ai/agentFactory.ts).
GROQ_API_KEY="gsk-..."
OPENAI_API_KEY="sk-..."
AI_PROVIDER="auto"
AI_MODEL="llama-3.3-70b-versatile"
AI_BASE_URL="https://api.groq.com/openai/v1"

# ── Meta (WhatsApp + Instagram) ──────────────────────────────────────────────
# META_VERIFY_TOKEN is REQUIRED in every environment.
# META_APP_SECRET enables X-Hub-Signature-256 verification. Without it, webhooks
# are accepted unauthenticated — never run production that way.
META_VERIFY_TOKEN="replace-with-random-verify-token"
META_APP_SECRET="replace-with-meta-app-secret"
WHATSAPP_TOKEN="replace-with-meta-system-user-token"
INSTAGRAM_TOKEN="replace-with-ig-access-token"

# ── Payments (Stripe, Phase 5.3 + 6.1) ───────────────────────────────────────
# Omit to disable payments; the API returns 503 on the payment-link route.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# SaaS Subscription Price IDs (Phase 6.1).
# Create one recurring price per plan in the Stripe Dashboard, then paste the
# price_* IDs below. Subscribe tenants via POST /api/billing/checkout.
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."

# ── Observability ────────────────────────────────────────────────────────────
# DOCS_ENABLED exposes Swagger UI at /docs. Turn OFF in production.
# Must be set to `false` in production; the code default is now `false`.
DOCS_ENABLED=false
SENTRY_DSN=""
OTEL_SERVICE_NAME="glambot-api"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_ENABLED=false


