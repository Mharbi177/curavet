# CuraVet production environment template
# Copy to .env and provide real secrets. Never commit populated values.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_API_URL="https://api.curavet.io"

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://curavet:curavet@localhost:5433/curavet?schema=public"
DIRECT_URL="postgresql://curavet:curavet@localhost:5433/curavet?schema=public"

# ── Queue (BullMQ / Redis) ───────────────────────────────────────────────────
# QUEUE_ENABLED=false runs without Redis; reminders, broadcasts and lifecycle
# sweeps are simply skipped. Never disable this in production.
REDIS_URL="redis://localhost:6379"
QUEUE_ENABLED=true

# ── Security ─────────────────────────────────────────────────────────────────
# Both secrets must be set in production. The API hard-fails to boot when it
# detects the built-in development defaults.
#   openssl rand -base64 48
JWT_SECRET="replace-with-64-char-random-secret"
CREDENTIALS_ENCRYPTION_KEY="replace-with-32-char-random-secret"
JWT_TTL_SECONDS="604800"

SUPERADMIN_EMAIL="admin@curavet.io"
SUPERADMIN_PASSWORD="replace-with-strong-password"

# ── AI providers ─────────────────────────────────────────────────────────────
# At least one is required for the assistant to answer. Tenants can pin a
# specific model (see MODEL_CATALOG in apps/api/src/ai/agentFactory.ts).
GROQ_API_KEY="gsk-..."
OPENAI_API_KEY="sk-..."
AI_PROVIDER="auto"
AI_MODEL="llama-3.1-8b-instant"
AI_BASE_URL="https://api.groq.com/openai/v1"

# ── Meta (WhatsApp + Instagram) ──────────────────────────────────────────────
# META_VERIFY_TOKEN is REQUIRED in every environment.
# META_APP_SECRET enables X-Hub-Signature-256 verification. Without it, webhooks
# are accepted unauthenticated — never run production that way.
META_VERIFY_TOKEN="replace-with-random-verify-token"
META_APP_SECRET="replace-with-meta-app-secret"
WHATSAPP_TOKEN="replace-with-meta-system-user-token"
INSTAGRAM_TOKEN="replace-with-ig-access-token"

# ── SMS ──────────────────────────────────────────────────────────────────────
# Platform-level provider config. Per-tenant tokens can still override the
# Twilio auth token via encrypted TenantIntegration credentials.
#   provider=twilio -> requires TWILIO_ACCOUNT_SID + (TWILIO_AUTH_TOKEN or tenant token)
#   provider=http   -> generic Tunisian gateway JSON POST (SMS_HTTP_ENDPOINT)
#   provider=none   -> local dev / tests: sends nothing
SMS_PROVIDER: z.enum(['twilio', 'http', 'none']).default('none')
TWILIO_ACCOUNT_SID: z.string().optional(),
TWILIO_AUTH_TOKEN: z.string().optional(),
TWILIO_FROM_NUMBER: z.string().optional(),
TWILIO_MESSAGING_SERVICE_SID: z.string().optional(),
SMS_HTTP_ENDPOINT: z.string().optional(),
SMS_HTTP_API_KEY: z.string().optional()

# ── Email (SendGrid) ────────────────────────────────────────────────────────
SENDGRID_API_KEY: z.string().optional()

# ── Queue / Redis ───────────────────────────────────────────────────────────
#
# `REDIS_URL` is the preferred form and takes precedence; the discrete
# host/port/password variables remain for managed-Redis setups that only
# hand out a hostname.
REDIS_URL: z.string().optional(),
REDIS_HOST: z.string().default('localhost'),
REDIS_PORT: z.string().default('6379'),
REDIS_PASSWORD: z.string().optional(),
QUEUE_ENABLED: z.string().default('true'),
REMINDER_CRON: z.string().default('*/5 * * * *')

# ── Payments ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY: z.string().optional(),
STRIPE_WEBHOOK_SECRET: z.string().optional(),
# SaaS Subscription Price IDs — one per plan (Phase 6.1).
# Create these in the Stripe Dashboard under Products → Prices.
STRIPE_PRICE_STARTER: z.string().optional(),
STRIPE_PRICE_PRO: z.string().optional(),
STRIPE_PRICE_ENTERPRISE: z.string().optional(),
PUBLIC_API_URL: z.string().default('http://localhost:3000'),
PUBLIC_FRONTEND_URL: z.string().default('http://localhost:3001')

# ── Observability ────────────────────────────────────────────────────────────
OTEL_ENABLED: z.string().default('false')
OTEL_SERVICE_NAME: z.string().default('curavet-api')
OTEL_EXPORTER_OTLP_ENDPOINT: z.string().optional()
SENTRY_DSN: z.string().optional()
LOG_LEVEL: z.string().default('info')

# ── Docs ─────────────────────────────────────────────────────────────────────
# DOCS_ENABLED exposes Swagger UI at /docs. Turn OFF in production.
# Must be set to `false` in production; the code default is now `false`.
DOCS_ENABLED: z.string().default('false')